{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "preview"
    },
    "production": {
      "ios": {
        "autoIncrement": "buildNumber"
      },
      "android": {
        "autoIncrement": "versionCode"
      },
      "distribution": "store",
      "channel": "production"
    },
    "review-production": {
      "extends": "production",
      "channel": "codex-review-1-11-7",
      "ios": {
        "autoIncrement": false
      },
      "android": {
        "autoIncrement": false
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6752890224",
        "appleTeamId": "53D8SBYZ7V"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed",
        "serviceAccountKeyPath": "./play-service-account.json"
      }
    },
    "closed-testing": {
      "android": {
        "track": "alpha",
        "releaseStatus": "draft",
        "serviceAccountKeyPath": "./play-service-account.json"
      }
    }
  }
}
